<Window x:Class="Vaja03.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vaja03"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280">
    <Grid>
        <Canvas x:Name="canvas" Margin="15,15,226,15"/>
        <GroupBox Header="GroupBox" Margin="0,10,10,475" HorizontalAlignment="Right" Width="211">
            <Grid>
                <Button Content="Generiraj tocke" Margin="0,115,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="84" Click="Button_Click"/>
                <TextBox x:Name="textBoxSt" Margin="0,77,10,0" TextWrapping="Wrap" Text="1000" VerticalAlignment="Top" HorizontalAlignment="Right" Width="120"/>
                <RadioButton x:Name="rbEnakomerno" Content="enakomerno porazdeljene" Margin="0,10,32,0" VerticalAlignment="Top" IsChecked="True" HorizontalAlignment="Right" Width="157"/>
                <RadioButton x:Name="rbNormalno" Content="normalno (gaussovo)&#xA; porazdeljene" Margin="0,30,41,0" VerticalAlignment="Top" Height="42" HorizontalAlignment="Right" Width="148"/>

            </Grid>
        </GroupBox>
        <GroupBox Header="GroupBox" Margin="0,0,10,29" HorizontalAlignment="Right" Width="211" Height="323" VerticalAlignment="Bottom">
            <Grid>
                <RadioButton x:Name="rbMinUtez" Content="Minimalna utezena triangulacija" HorizontalAlignment="Left" IsChecked="True" Margin="10,10,0,0" VerticalAlignment="Top"/>
                <RadioButton x:Name="rbHamilton" Content="Hamiltonova triangulacija" HorizontalAlignment="Left" Margin="10,30,0,0" VerticalAlignment="Top"/>
                <Button x:Name="btnStart" Content="Start" HorizontalAlignment="Left" Margin="126,270,0,0" VerticalAlignment="Top" Width="63" Click="btnStart_Click"/>

            </Grid>
        </GroupBox>
        <Label x:Name="lbTime" Content="" HorizontalAlignment="Left" Margin="1059,0,0,366" VerticalAlignment="Bottom" Width="211"/>

    </Grid>
</Window>
